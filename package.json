{
  "name": "warmup-vein-enhancer-sleeve",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Informational single-page website for the WARMUP Vein Enhancer Sleeve.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .cache/ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "images": "python3 scripts/build_images.py",
    "images:crops": "python3 scripts/build_images.py --crops",
    "shots": "node scripts/shots.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
